<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="https://matcha.mizu.sh/matcha.css">
  <title>cs2-presence</title>
</head>

<body>
  <main style="max-width: 48rem; margin-left: auto; margin-right: auto;">
    <figure>
      <% if (it.options.fluffy===true) { %>
        <img src="https://cdn.discordapp.com/app-assets/1481083110971019396/1481088949593047070.png">
        <% } else { %>
          <img src="https://cdn.discordapp.com/app-assets/1481083110971019396/1481083293792211095.png">
          <% } %>
            <figcaption><a href="https://github.com/kibibites/cs2-presence" rel="noopener noreferrer"
                target="_blank">cs2-presence</a></figcaption>
    </figure>
    <h2>preview</h2>
    <h2>options</h2>
    <p>
      timeout: time to wait in milliseconds before clearing your discord status, when no more new events are received
      from cs2.
    </p>
    <form class="px-2">
      <label class="flex align-center">
        timeout
        <input class="ml-1" name="unused" type="number" value="<%= it.options.timeout %>">
      </label>
      <fieldset class="flex space-around">
        <legend>fluffy icon?</legend>
        <label><input type="radio" name="fluffy" value="always" <% if (it.options.fluffy && !it.options.disableFluffy) {
            %> checked <% } %>>always</label>
        <label><input type="radio" name="fluffy" value="sometimes" <% if (!it.options.disableFluffy &&
            !it.options.fluffy) { %> checked <% } %>>sometimes</label>
        <label><input type="radio" name="fluffy" value="never" <% if (it.options.disableFluffy) { %> checked <% } %>
            >never</label>
      </fieldset>
      <button type="submit">submit</button>
    </form>
  </main>

  <script type="module">
    import { decodeCbor } from "https://esm.sh/jsr/@std/cbor";
    let last_pong = 0;

    const ws = new WebSocket("ws://localhost:8000/ws");

    ws.addEventListener('open', () => setInterval(() => {
      ws.send(new Uint8Array([0xe2, 0x99, 0xa1]))
    }, 2000));

    ws.addEventListener('message', (m) => {
      const pong = new Uint8Array([0xe2, 0x99, 0xa5]);
      if (data.length === 3 && data.every((v, i) => v === ping[i])) {
        last_pong = Date.now();
      } else {
        // const data = 
      }
    })

  </script>
</body>

</html>