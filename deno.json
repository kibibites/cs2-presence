{
  "tasks": {
    "dev": "DEV=1 deno run --unstable-tsgo --unstable-fs --unstable-raw-imports --watch -A ./src/main.ts",
    "build": "deno bundle --unstable-tsgo --allow-import --unstable-raw-imports --frozen --lock --minify ./src/main.ts -o ./dist/cs2-presence.js",
    "compile:windows": {
      "command": "deno compile --unstable-fs -A --target=x86_64-pc-windows-msvc --icon icon.ico -o ./dist/ ./dist/cs2-presence.js",
      "dependencies": ["build"]
    },
    "compile:linux": {
      "command": "deno compile --unstable-fs -A --target=x86_64-unknown-linux-gnu -o ./dist/ ./dist/cs2-presence.js",
      "dependencies": ["build"]
    },
    "compile": { "dependencies": ["compile:windows", "compile:linux"] },
    "compress:windows": "pixz -i ./dist/cs2-presence.exe -o ./dist/cs2-presence.exe.xz -9",
    "compress:linux": "pixz -i ./dist/cs2-presence -o ./dist/cs2-presence.xz -9",
    "compress": { "dependencies": ["compress:windows", "compress:linux"] },
    "clean": "rm -rf dist"
  },
  "imports": {
    "@logtape/file": "jsr:@logtape/file@^2.0.4",
    "@logtape/logtape": "jsr:@logtape/logtape@^2.0.4",
    "@sigma/deno-compile-extra": "jsr:@sigma/deno-compile-extra@^0.13.0",
    "@std/cbor": "jsr:@std/cbor@^0.1.9",
    "@std/semver": "jsr:@std/semver@^1.0.8",
    "csgo-gsi-types": "npm:csgo-gsi-types@^1.0.7",
    "discord_rpc": "https://deno.land/x/discord_rpc@0.3.2/mod.ts"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "preact"
  },
  "allowScripts": ["npm:@parcel/watcher@2.5.6"]
}
